{
  "name": "medic-action",
  "version": "1.0.0",
  "description": "GitHub Action with manual and automated capabilities to resolve trivial blockers in merging PRs",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm run build:checker && pnpm run build:comment-parser && pnpm run build:fixer",
    "build:checker": "ncc build src/checker.ts -o dist/checker",
    "build:comment-parser": "ncc build src/comment-parser.ts -o dist/comment-parser",
    "build:fixer": "ncc build src/fixer.ts -o dist/fixer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["github-action", "merge-conflict", "claude", "automation"],
  "author": "Chainlink",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.10",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  }
}

